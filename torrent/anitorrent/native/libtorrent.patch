+	void torrent::forget_pieces(std::vector<piece_index_t> const& pieces)
+	{
+		TORRENT_ASSERT(is_single_thread());
+		if (!valid_metadata() || pieces.empty()) return;
+		need_picker();
+		bool const was_finished = is_finished();
+
+		bool forgot = false;
+		for (piece_index_t const index : pieces)
+		{
+			if (index < piece_index_t(0) || index >= m_torrent_file->end_piece()) continue;
+			if (!m_picker->have_piece(index)) continue;
+			m_picker->we_dont_have(index);
+			inc_stats_counter(counters::num_have_pieces, -1);
+			forgot = true;
+			for (auto p : m_connections)
+			{
+				TORRENT_INCREMENT(m_iterating_connections);
+				// the same as when a piece fails its hash check: reject outstanding
+				// requests and tell peers that support it we don't have it
+				p->reject_piece(index);
+				p->write_dont_have(index);
+			}
+		}
+		if (!forgot) return;
+
+		m_have_all = false;
+		m_file_progress.clear();
+		m_file_progress.init(*m_picker, m_torrent_file->files());
+		// a seed that lost pieces nobody wants is only finished. If some of them
+		// are still wanted, update_peer_interest() resumes the download
+		if (m_state == torrent_status::seeding && is_finished())
+			set_state(torrent_status::finished);
+		update_peer_interest(was_finished);
+		update_gauge();
+		set_need_save_resume(torrent_handle::if_download_progress);
+		state_updated();
+	}
+
 	void torrent::force_recheck()
 	{
 		INVARIANT_CHECK;
