+#ifndef ANITORRENT_WRITE_BACK_DISK_IO_H
+#define ANITORRENT_WRITE_BACK_DISK_IO_H
+
+#include <atomic>
+#include <memory>
+#include <mutex>
+#include <string>
+
+#include "libtorrent/disk_interface.hpp"
+#include "libtorrent/io_context.hpp"
+
+#include "write_back.hpp"
+
+namespace anilt {
+class write_back_disk_io;
+
+/**
+ * session_t 与磁盘读写包装层 (write_back_disk_io) 共享的状态.
+ *
+ * 两把锁分开: listener_mutex 在调用 Java 回调期间一直持有, 保证 set_listener(nullptr) 返回后不再有回调;
+ * disk_mutex 只保护包装层与网络线程的入口, write_back_done 只碰它. disk_mutex 可重入: 放开接收时 (持有它)
+ * 放出的写入可能再次回调, 回调里直接调用 write_back_done 也不会死锁.
+ * 都不用 anitorrent 的全局锁: wait_for_alert 会持有它好几秒, 放开接收不能被它拖住.
+ */
+struct write_back_control : std::enable_shared_from_this<write_back_control> {
+    std::mutex listener_mutex;
+    write_back_listener_t *listener = nullptr; // guarded by listener_mutex
+
+    std::recursive_mutex disk_mutex;
+    write_back_disk_io *disk = nullptr; // guarded by disk_mutex, 包装层存活期间有效
+    lt::io_context *ios = nullptr;      // guarded by disk_mutex
+
+    /// 等落盘超过 write_back_disk_io 的超时、被强制放开的次数
+    std::atomic<int64_t> forced_releases{0};
+
+    void set_listener(write_back_listener_t *l);
+
+    /// 任意线程. 交给网络线程放开 path 上的等待.
+    void done(const std::string &path);
+};
+
+/**
+ * 换掉种子里的文件 (torrent_handle_t::discard_file 打洞或重写成稀疏文件) 期间持有. 包装层转给里层的读写都先拿它:
+ * 里层在网络线程上同步读写, 换文件时就不会写进将被换掉的旧文件 (那段数据会随旧文件丢掉, 分块却已算下好).
+ */
+std::recursive_mutex &file_replace_mutex();
+
+/**
+ * 续传数据的写入 (events.cpp 检查后交给 Java 写盘, 整段拿着它) 与 torrent_handle_t::discard_file 忘掉分块、删掉旧续传数据互斥:
+ * 写到一半的旧数据不会在删掉之后又写回来; 忘掉之前生成、之后才送到的旧数据过不了检查 (它还记着忘掉的分块).
+ */
+std::mutex &resume_data_mutex();
+
+std::unique_ptr<lt::disk_interface> create_write_back_disk_io(lt::io_context &ios,
+                                                              lt::settings_interface const &settings,
+                                                              lt::counters &counters,
+                                                              std::shared_ptr<write_back_control> control);
+} // namespace anilt
+
+#endif // ANITORRENT_WRITE_BACK_DISK_IO_H
