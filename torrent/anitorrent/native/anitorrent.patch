+    }
+
+    void async_delete_files(lt::storage_index_t storage, lt::remove_flags_t options,
+                            std::function<void(lt::storage_error const &)> handler) override {
+        std::lock_guard g(file_replace_mutex());
+        inner_->async_delete_files(storage, options, std::move(handler));
+    }
+
+    void async_set_file_priority(
+        lt::storage_index_t storage, lt::aux::vector<lt::download_priority_t, lt::file_index_t> prio,
+        std::function<void(lt::storage_error const &, lt::aux::vector<lt::download_priority_t, lt::file_index_t>)>
+            handler) override {
+        // 不下载的文件里的数据写进 .parts, 上报时要据此选路径
