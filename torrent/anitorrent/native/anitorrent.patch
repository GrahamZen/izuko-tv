+/**
+ * 包在 libtorrent 自带的磁盘读写 (anitorrent 关了 mmap, 是 posix 那套) 外面, 让 BT 下载和在线源一样
+ * 「写够一段就落盘, 落完再收」.
+ *
+ * posix 那套在网络线程上同步写盘 (每块 fopen / fwrite / fclose, 数据进内核的页缓存), 永远告诉连接「磁盘不忙」,
+ * 网速比磁盘快时没落盘的数据就越积越多. 本层把每次写入按文件报给 write_back_listener_t; 回调要求落盘时,
+ * 先把写完成的回调压住并告诉连接「磁盘忙」 (async_write 返回 true), 连接于是暂不读取;
+ * 调用方落完盘调用 write_back_done 后再一起放出, 并通知连接继续 (disk_observer::on_disk).
+ *
+ * 除 release 外全部在网络线程上调用. 转给里层的读写都拿着 file_replace_mutex.
+ */
+class write_back_disk_io final : public lt::disk_interface {
+  public:
+    write_back_disk_io(lt::io_context &ios, std::unique_ptr<lt::disk_interface> inner,
+                       std::shared_ptr<write_back_control> control)
+        : ios_(ios), inner_(std::move(inner)), control_(std::move(control)), timer_(ios) {
+        std::lock_guard g(control_->disk_mutex);
+        control_->disk = this;
+        control_->ios = &ios_;
+    }
+
+    ~write_back_disk_io() override {
+        std::lock_guard g(control_->disk_mutex);
+        control_->disk = nullptr;
+        control_->ios = nullptr;
+    }
+
+    /// 网络线程. 调用方对 path 落完盘了; 所有路径都落完时放开接收.
+    void release(const std::string &path) {
+        auto const it = holding_.find(path);
+        if (it == holding_.end()) return;
+        if (--it->second <= 0) holding_.erase(it);
+        if (holding_.empty()) release_all();
+    }
+
+    lt::storage_holder new_torrent(lt::storage_params const &p, std::shared_ptr<void> const &torrent) override {
+        lt::storage_holder inner = inner_->new_torrent(p, torrent);
+        lt::storage_index_t const idx = inner;
+        torrent_files entry{
+            p.mapped_files ? p.mapped_files : &p.files,
+            p.path,
+            combine(p.path, "." + to_hex(p.info_hash) + ".parts"),
+            p.priorities,
+            std::move(inner),
+        };
+        torrents_.erase(idx);
+        torrents_.emplace(idx, std::move(entry));
+        // 句柄改由本层持有: 种子移除时先经过本层的 remove_torrent, 里层的句柄随条目一起释放
+        return {idx, *this};
+    }
+
+    void remove_torrent(lt::storage_index_t idx) override { torrents_.erase(idx); }
+
+    void async_read(lt::storage_index_t storage, lt::peer_request const &r,
+                    std::function<void(lt::disk_buffer_holder, lt::storage_error const &)> handler,
+                    lt::disk_job_flags_t flags) override {
+        std::lock_guard g(file_replace_mutex());
+        inner_->async_read(storage, r, std::move(handler), flags);
+    }
+
+    bool async_write(lt::storage_index_t storage, lt::peer_request const &r, char const *buf,
+                     std::shared_ptr<lt::disk_observer> o, std::function<void(lt::storage_error const &)> handler,
+                     lt::disk_job_flags_t flags) override {
+        // 里层在这里就同步写完了, 写完成的回调稍后才投递到网络线程: 那时若在等落盘, 先压住
+        {
+            std::lock_guard g(file_replace_mutex());
+            inner_->async_write(
+                storage, r, buf, o,
+                [this, handler = std::move(handler)](lt::storage_error const &e) {
+                    if (!holding_.empty()) {
+                        held_.emplace_back([handler, e] { handler(e); });
+                        return;
+                    }
+                    handler(e);
+                },
+                flags);
+        }
+        report(storage, r);
+        if (holding_.empty()) return false;
+        if (o) observers_.emplace_back(o);
+        return true;
+    }
+
+    void async_hash(lt::storage_index_t storage, lt::piece_index_t piece, lt::span<lt::sha256_hash> v2,
+                    lt::disk_job_flags_t flags,
+                    std::function<void(lt::piece_index_t, lt::sha1_hash const &, lt::storage_error const &)> handler)
+        override {
+        std::lock_guard g(file_replace_mutex());
+        inner_->async_hash(storage, piece, v2, flags, std::move(handler));
+    }
+
+    void async_hash2(lt::storage_index_t storage, lt::piece_index_t piece, int offset, lt::disk_job_flags_t flags,
+                     std::function<void(lt::piece_index_t, lt::sha256_hash const &, lt::storage_error const &)> handler)
+        override {
+        std::lock_guard g(file_replace_mutex());
+        inner_->async_hash2(storage, piece, offset, flags, std::move(handler));
+    }
+
+    void async_move_storage(lt::storage_index_t storage, std::string p, lt::move_flags_t flags,
+                            std::function<void(lt::status_t, std::string const &, lt::storage_error const &)> handler)
+        override {
+        std::lock_guard g(file_replace_mutex());
+        inner_->async_move_storage(storage, std::move(p), flags, std::move(handler));
+    }
+
+    void async_release_files(lt::storage_index_t storage, std::function<void()> handler) override {
+        inner_->async_release_files(storage, std::move(handler));
+    }
+
+    void async_check_files(lt::storage_index_t storage, lt::add_torrent_params const *resume_data,
