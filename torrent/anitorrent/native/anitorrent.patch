@@ -0,0 +1,30 @@
+#ifndef ANITORRENT_WRITE_BACK_H
+#define ANITORRENT_WRITE_BACK_H
+
+#include <cstdint>
+#include <string>
+
+namespace anilt {
+extern "C" {
+
+/**
+ * 写盘回调, 由调用方决定什么时候落盘 (与在线源下载用同一套「写够一段就落盘, 落完再收」).
+ *
+ * libtorrent 每往一个文件写够 write_back_report_bytes 就调用一次 on_written (在网络线程上, 要尽快返回).
+ * 返回 true 表示现在要把这个文件落盘: 在调用方对同一路径调用 session_t::write_back_done 之前,
+ * libtorrent 不再从连接里收数据 (连接不断开, 只是暂不读取). 没选中的文件里的数据写在种子的 .parts 文件里,
+ * 这时 path 是 .parts 文件的路径.
+ */
+class write_back_listener_t {
+  public:
+    virtual ~write_back_listener_t() = default;
+
+    virtual bool on_written(const std::string &path, int64_t bytes) = 0;
+};
+
+/// 累计写够这么多字节才回调一次 on_written, 免得每个 16 KiB 的块都调用一次 Java.
+constexpr int64_t write_back_report_bytes = 256 * 1024;
+}
+} // namespace anilt
+
+#endif // ANITORRENT_WRITE_BACK_H
