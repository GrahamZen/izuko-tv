+int torrent_handle_t::discard_file(const int index, const std::string &resume_path) const {
+    function_printer_t _fp("torrent_handle_t::discard_file");
+    guard_global_lock;
+    try {
+        const auto handle = handle_;
+        if (!handle || !handle->is_valid()) return -1;
+        const auto ti = handle->torrent_file();
+        if (!ti || !ti->is_valid()) return -1;
+        const auto &fs = ti->files();
+        const libtorrent::file_index_t file{index};
+        if (index < 0 || file >= fs.end_file() || fs.pad_file_at(file)) return -1;
+
+        const own_pieces_t own = own_pieces(fs, file);
+        if (own.first >= own.end) return 0; // 文件比一块还小, 没有能丢的整块
+
+#if defined(__linux__)
+        std::string const path =
+            fs.file_path(file, handle->status(libtorrent::torrent_handle::query_save_path).save_path);
+        // 还不回空间就什么都不动: 分块留着照样能用
+        if (int const r = check_space_releasable(path, 2 * own.piece_length); r != 0) return r;
+
+        std::vector<libtorrent::piece_index_t> pieces;
+        pieces.reserve(static_cast<std::size_t>(own.end - own.first));
+        for (std::int64_t p = own.first; p < own.end; ++p) pieces.emplace_back(static_cast<int>(p));
+        {
+            std::lock_guard g(resume_data_mutex());
+            handle->forget_pieces(std::move(pieces));
+            ::unlink(resume_path.c_str());
+        }
+        // 首尾与相邻集共用的分块可能正在下载, 重写期间不能让网络线程往旧文件里写
+        std::lock_guard g(file_replace_mutex());
+        int const r = punch_out(path, own.hole_begin, own.hole_end);
+        return r == 0 ? 0 : 1000 + r;
+#else
+        return -2;
+#endif
+    } catch (const std::exception &) {
+        return -1;
+    }
+}
+
+bool torrent_handle_t::has_discardable_data(const int index) const {
+    function_printer_t _fp("torrent_handle_t::has_discardable_data");
+    guard_global_lock;
+    try {
+        const auto handle = handle_;
+        if (!handle || !handle->is_valid()) return false;
+        const auto ti = handle->torrent_file();
+        if (!ti || !ti->is_valid()) return false;
+        const auto &fs = ti->files();
+        const libtorrent::file_index_t file{index};
+        if (index < 0 || file >= fs.end_file() || fs.pad_file_at(file)) return false;
+
+        const own_pieces_t own = own_pieces(fs, file);
+        const auto pieces = handle->status(libtorrent::torrent_handle::query_pieces).pieces;
+        for (std::int64_t p = own.first; p < own.end && p < pieces.size(); ++p) {
+            if (pieces[libtorrent::piece_index_t(static_cast<int>(p))]) return true;
+        }
+        return false;
+    } catch (const std::exception &) {
+        return false;
+    }
+}
