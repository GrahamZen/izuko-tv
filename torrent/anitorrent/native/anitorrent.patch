+/// 把 [from, to) 从 in 抄到 out 的同一位置. 成功返回 0, 否则 errno.
+int copy_range(const int in, const int out, std::int64_t from, const std::int64_t to) {
+    std::vector<char> buf(1 << 20);
+    while (from < to) {
+        auto const want = static_cast<std::size_t>(std::min<std::int64_t>(static_cast<std::int64_t>(buf.size()), to - from));
+        ssize_t const n = ::pread(in, buf.data(), want, from);
+        if (n < 0) return errno;
+        if (n == 0) return 0; // 文件比记的短 (还没下到那里): 剩下的本来就是空洞
+        if (::pwrite(out, buf.data(), static_cast<std::size_t>(n), from) != n) return errno;
+        from += n;
+    }
+    return 0;
+}
+
+/// 把 [path] 的 [hole_begin, hole_end) 变成空洞, 文件大小不变. 成功返回 0, 否则 errno.
+int punch_out(const std::string &path, const std::int64_t hole_begin, const std::int64_t hole_end) {
+    int const fd = ::open(path.c_str(), O_RDWR | O_CLOEXEC);
+    if (fd < 0) return errno == ENOENT ? 0 : errno; // 还没建出来的文件没有要还的空间
+    if (::fallocate(fd, FALLOC_FL_PUNCH_HOLE | FALLOC_FL_KEEP_SIZE, hole_begin, hole_end - hole_begin) == 0) {
+        ::close(fd);
+        return 0;
+    }
+    int const err = errno;
+    if (err != EOPNOTSUPP && err != ENOSYS) {
+        ::close(fd);
+        return err;
+    }
+    // 不支持打洞: 重写成只留首尾数据的稀疏文件
+    struct stat st{};
+    if (::fstat(fd, &st) != 0) {
+        int const e = errno;
+        ::close(fd);
+        return e;
+    }
+    std::string const tmp = path + ".discarding";
+    int const out = ::open(tmp.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, st.st_mode & 07777);
+    if (out < 0) {
+        int const e = errno;
+        ::close(fd);
+        return e;
+    }
+    int r = ::ftruncate(out, st.st_size) == 0 ? 0 : errno;
+    if (r == 0) r = copy_range(fd, out, 0, std::min<std::int64_t>(hole_begin, st.st_size));
+    if (r == 0) r = copy_range(fd, out, hole_end, st.st_size);
+    if (r == 0 && ::fsync(out) != 0) r = errno;
+    ::close(out);
+    ::close(fd);
+    if (r == 0 && ::rename(tmp.c_str(), path.c_str()) != 0) r = errno;
+    if (r != 0) ::unlink(tmp.c_str());
+    return r;
+}
+
+/// 打洞或改写成稀疏文件能不能把 [path] 的空间还回去 (FAT / exFAT 不能). 能返回 0, 文件不在也算能; 否则返回 errno.
+int check_space_releasable(const std::string &path, const std::int64_t probe_size) {
+    int const fd = ::open(path.c_str(), O_RDWR | O_CLOEXEC);
+    if (fd < 0) return errno == ENOENT ? 0 : errno;
+    struct stat st{};
+    if (::fstat(fd, &st) != 0) {
+        int const e = errno;
+        ::close(fd);
+        return e;
+    }
+    // 在文件末尾之后打洞什么都不改, 只看支不支持
+    if (::fallocate(fd, FALLOC_FL_PUNCH_HOLE | FALLOC_FL_KEEP_SIZE, st.st_size, 1) == 0) {
+        ::close(fd);
+        return 0;
+    }
+    int const err = errno;
+    ::close(fd);
+    if (err != EOPNOTSUPP && err != ENOSYS) return err;
+    // 不支持打洞: 改写成稀疏文件要靠文件系统支持空洞, 拿一个只设了大小的文件试
+    std::string const probe = path + ".probe";
+    int const out = ::open(probe.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0600);
+    if (out < 0) return errno;
+    int r = ::ftruncate(out, probe_size) == 0 ? 0 : errno;
+    struct stat ps{};
+    if (r == 0 && ::fstat(out, &ps) != 0) r = errno;
+    ::close(out);
+    ::unlink(probe.c_str());
+    if (r != 0) return r;
+    return static_cast<std::int64_t>(ps.st_blocks) * 512 < probe_size / 2 ? 0 : EOPNOTSUPP;
