+namespace {
+/// 完全落在一个文件里的分块 [first, end), 以及它们在文件里占的那一段 [hole_begin, hole_end)
+struct own_pieces_t {
+    std::int64_t first = 0;
+    std::int64_t end = 0;
+    std::int64_t hole_begin = 0;
+    std::int64_t hole_end = 0;
+    std::int64_t file_size = 0;
+    std::int64_t piece_length = 0;
+};
+
+own_pieces_t own_pieces(const libtorrent::file_storage &fs, const libtorrent::file_index_t file) {
+    own_pieces_t r;
+    std::int64_t const offset = fs.file_offset(file);
+    r.file_size = fs.file_size(file);
+    r.piece_length = fs.piece_length();
+    r.first = (offset + r.piece_length - 1) / r.piece_length;
+    // 种子最后一块不满一整块, 落在最后一个文件里时也只属于它
+    r.end = offset + r.file_size == fs.total_size() ? fs.num_pieces() : (offset + r.file_size) / r.piece_length;
+    if (r.first < r.end) {
+        r.hole_begin = r.first * r.piece_length - offset;
+        r.hole_end = std::min(r.end * r.piece_length, offset + r.file_size) - offset;
+    }
+    return r;
+}
