+        std::lock_guard g(file_replace_mutex());
+        inner_->async_set_file_priority(storage, std::move(prio), std::move(handler));
+    }
+
+    void async_clear_piece(lt::storage_index_t storage, lt::piece_index_t index,
+                           std::function<void(lt::piece_index_t)> handler) override {
+        inner_->async_clear_piece(storage, index, std::move(handler));
+    }
+
+    void update_stats_counters(lt::counters &c) const override { inner_->update_stats_counters(c); }
+
+    std::vector<lt::open_file_state> get_status(lt::storage_index_t storage) const override {
+        return inner_->get_status(storage);
+    }
+
+    void abort(bool wait) override {
+        holding_.clear();
+        release_all();
+        inner_->abort(wait);
+    }
+
+    void submit_jobs() override { inner_->submit_jobs(); }
+
+    void settings_updated() override { inner_->settings_updated(); }
+
+  private:
+    struct torrent_files {
+        lt::file_storage const *files;
+        std::string save_path;
+        std::string part_file;
+        lt::aux::vector<lt::download_priority_t, lt::file_index_t> priorities;
+        lt::storage_holder inner;
+    };
+
+    void report(lt::storage_index_t storage, lt::peer_request const &r) {
+        auto const t = torrents_.find(storage);
+        if (t == torrents_.end()) return;
+        torrent_files const &tf = t->second;
+        for (auto const &slice : tf.files->map_block(r.piece, r.start, r.length)) {
+            if (tf.files->pad_file_at(slice.file_index)) continue;
+            bool const to_part_file = slice.file_index < tf.priorities.end_index() &&
+                                      tf.priorities[slice.file_index] == lt::dont_download;
+            std::string path =
+                to_part_file ? tf.part_file : tf.files->file_path(slice.file_index, tf.save_path);
+            int64_t &pending = unreported_[path];
+            pending += slice.size;
+            if (pending < write_back_report_bytes) continue;
+            int64_t const bytes = pending;
+            pending = 0;
+            if (notify(path, bytes)) hold(path);
+        }
+    }
+
+    bool notify(const std::string &path, int64_t bytes) {
+        std::lock_guard g(control_->listener_mutex);
+        write_back_listener_t *const listener = control_->listener;
+        if (!listener) return false;
+        try {
+            return listener->on_written(path, bytes);
+        } catch (...) {
+            return false;
+        }
+    }
+
+    void hold(const std::string &path) {
+        bool const first = holding_.empty();
+        ++holding_[path];
+        if (!first) return;
+        timer_.expires_after(hold_timeout);
+        timer_.async_wait([this](boost::system::error_code const &ec) {
+            // 取消 (正常放开 / 本层析构) 时 ec 非空, 不能再碰 this
+            if (ec || holding_.empty()) return;
+            control_->forced_releases.fetch_add(1);
+            holding_.clear();
+            release_all();
+        });
+    }
+
+    void release_all() {
+        timer_.cancel();
+        std::vector<std::function<void()>> held = std::move(held_);
+        held_.clear();
+        std::vector<std::weak_ptr<lt::disk_observer>> observers = std::move(observers_);
+        observers_.clear();
+        for (auto &h : held) h();
+        for (auto &w : observers) {
+            if (auto const o = w.lock()) o->on_disk();
+        }
+    }
+
+    lt::io_context &ios_;
+    std::unique_ptr<lt::disk_interface> inner_;
+    std::shared_ptr<write_back_control> control_;
+    boost::asio::steady_timer timer_;
+
+    // 在 inner_ 之后声明: 先于 inner_ 析构, 条目里的里层句柄才能交还给还活着的 inner_
+    std::map<lt::storage_index_t, torrent_files> torrents_;
+    std::unordered_map<std::string, int64_t> unreported_;
+    std::map<std::string, int> holding_;
+    std::vector<std::function<void()>> held_;
+    std::vector<std::weak_ptr<lt::disk_observer>> observers_;
+};
+
+std::recursive_mutex &file_replace_mutex() {
+    static std::recursive_mutex m;
+    return m;
+}
+
+std::mutex &resume_data_mutex() {
+    static std::mutex m;
+    return m;
+}
+
+void write_back_control::set_listener(write_back_listener_t *l) {
+    std::lock_guard g(listener_mutex);
+    listener = l;
+}
+
+void write_back_control::done(const std::string &path) {
+    std::lock_guard g(disk_mutex);
+    if (!ios) return;
+    boost::asio::post(*ios, [self = shared_from_this(), path] {
+        std::lock_guard g2(self->disk_mutex);
+        if (self->disk) self->disk->release(path);
+    });
+}
+
+std::unique_ptr<lt::disk_interface> create_write_back_disk_io(lt::io_context &ios,
+                                                              lt::settings_interface const &settings,
+                                                              lt::counters &counters,
+                                                              std::shared_ptr<write_back_control> control) {
+    return std::make_unique<write_back_disk_io>(ios, lt::default_disk_io_constructor(ios, settings, counters),
+                                                std::move(control));
+}
