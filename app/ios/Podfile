require_relative 'scripts/sentry_terminate_patch'

target 'Animeko' do
  use_frameworks!
  platform :ios, '16.0'
  pod 'application', :path => '../shared/application'
  # application 依赖的 onnxruntime 两个 pod 从本地目录装 (见 ../shared/application/onnxruntime-pods/README.md)
  pod 'onnxruntime-objc', :path => '../shared/application/onnxruntime-pods/onnxruntime-objc'
  pod 'onnxruntime-c', :path => '../shared/application/build/onnxruntime-c'

  pod 'Sentry', '~> 8.49.0'
end

post_install do |installer|
  SentryTerminatePatch.apply(installer.sandbox.root)
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
    end
  end
end
