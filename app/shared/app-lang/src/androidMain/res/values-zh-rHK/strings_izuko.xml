    <string name="settings_network_bangumi_endpoint">Bangumi 連線方式</string>
    <string name="settings_network_bangumi_endpoint_description">2026 年 5 月起 Bangumi 在中國大陸被阻斷, API 也一樣不通。建議優先設置「代理」：應用直連 Bangumi 官方，不經過任何第三方。社群的反代鏡像也可以恢復瀏覽。</string>
    <string name="settings_network_bangumi_mode">怎麼連 Bangumi</string>
    <string name="settings_network_bangumi_direct">只連官方</string>
    <string name="settings_network_bangumi_auto">官方連不上時用鏡像</string>
    <string name="settings_network_bangumi_mirror">用鏡像</string>
    <string name="settings_network_bangumi_auto_description">確定連不上官方後會自動改成「用鏡像」，之後不再先試官方；需要時再改回這一檔。</string>
    <string name="settings_network_bangumi_builtin_mirrors">內建鏡像：%1$s（清單每天自動更新，按順序嘗試）</string>
    <string name="settings_network_bangumi_custom">用我自己的鏡像</string>
    <string name="settings_network_bangumi_no_login_notice">登入與收藏同步仍然只走官方或你自己的鏡像 —— 第三方反代能看到你的登入憑證。</string>
    <string name="settings_network_bangumi_mirror_credentials">登入與收藏同步也經過鏡像</string>
    <string name="settings_network_bangumi_mirror_credentials_on">你的登入憑證與收藏資料會經過鏡像，風險由你自行承擔。</string>
    <string name="settings_network_bangumi_mirror_credentials_risk_title">允許帳號資料經過鏡像？</string>
    <string name="settings_network_bangumi_mirror_credentials_risk_message">鏡像由第三方營運。打開後，你的 Bangumi 登入憑證、收藏與觀看進度都會經過鏡像伺服器，對方可以看到並使用你的帳號，由此產生的風險由你自行承擔。\n\n更安全的做法是設置「代理」：應用直連 Bangumi 官方，不經過任何第三方。</string>
    <string name="settings_network_bangumi_mirror_credentials_risk_confirm">我了解風險，打開</string>
    <string name="settings_network_bangumi_mirror_credentials_cancel">取消</string>
    <string name="settings_network_bangumi_mirror_switch_title">已登入，改用鏡像？</string>
    <string name="settings_network_bangumi_mirror_switch_message">你已登入 Bangumi。登入後的請求（收藏、進度、評分，以及登入後瀏覽條目）默認只走官方，不經過第三方鏡像，官方連不上時都會失敗。\n\n選「允許並改用鏡像」後，你的 Bangumi 登入憑證、收藏與觀看進度都會經過鏡像伺服器，對方可以看到並使用你的帳號，由此產生的風險由你自行承擔。不想交出帳號的話，可以登出，只用鏡像瀏覽。</string>
    <string name="settings_network_bangumi_mirror_auto_title">連不上 Bangumi 官方</string>
    <string name="settings_network_bangumi_mirror_auto_message">現在連不上 Bangumi 官方，鏡像能用。你已登入，登入後的請求（收藏、進度，以及登入後瀏覽條目）默認只走官方，所以現在都會失敗。\n\n改用鏡像並允許登入經過鏡像後，你的 Bangumi 登入憑證、收藏與觀看進度都會經過鏡像伺服器，對方可以看到並使用你的帳號，由此產生的風險由你自行承擔。也可以登出，只用鏡像瀏覽；或者設置代理，直連官方。</string>
    <string name="settings_network_bangumi_mirror_switch_allow">允許並改用鏡像</string>
    <string name="settings_network_bangumi_mirror_switch_logout">登出並改用鏡像</string>
    <string name="settings_network_bangumi_mirror_switch_later">暫不</string>
    <string name="settings_network_bangumi_mirror_credentials_off_title">關閉後登入請求只走官方</string>
    <string name="settings_network_bangumi_mirror_credentials_off_message">現在用的是鏡像。關閉後，登入後的請求（收藏、進度，以及登入後瀏覽條目）只走官方，官方連不上時都會失敗。</string>
    <string name="settings_network_bangumi_mirror_credentials_off_confirm">仍然關閉</string>
    <string name="settings_network_bangumi_custom_url">鏡像位址</string>
    <string name="settings_network_bangumi_custom_url_description">填反代的根網域, 要求它把 Bangumi 的各個子網域 (api. / next. / lain. …) 一起鏡像。這一檔可以登入。</string>
    <string name="settings_network_bangumi_custom_url_invalid">請填根網域, 例如 bangumi.example.com</string>
    <string name="tv_onboarding_welcome_title">歡迎使用 Izuko TV</string>
    <string name="tv_onboarding_welcome_intro">純淨無廣告，找番、追番、看番都在這裡：番劇資訊和觀看進度同步 Bangumi，聚合多個視頻數據源和彈幕，還能離線緩存。</string>
    <string name="tv_onboarding_welcome_description">開始之前需要做三步設置：</string>
    <string name="tv_onboarding_welcome_step_network">檢測網絡，選擇怎麼連線 Bangumi、怎麼載入 TMDB 圖片</string>
    <string name="tv_onboarding_welcome_step_remote">用手機掃碼打開 Web 控制台，當遙控器和鍵盤用</string>
    <string name="tv_onboarding_welcome_step_login">登錄 Bangumi 帳號（可以跳過）</string>
    <string name="tv_onboarding_welcome_start">開始設置</string>
    <string name="tv_onboarding_step_network">檢測網絡</string>
    <string name="tv_onboarding_step_remote">手機遙控</string>
    <string name="tv_onboarding_remote_description">用手機掃右邊的二維碼，打開這部電視的 Web 控制台（手機要和電視連同一個 Wi-Fi）。不用裝應用，瀏覽器就能用：</string>
    <string name="tv_onboarding_remote_feature_search">在手機上打字搜尋番劇，結果直接在電視上打開</string>
    <string name="tv_onboarding_remote_feature_player">挑選數據源、暫停快進、調倍速，像遙控器一樣控制播放</string>
    <string name="tv_onboarding_remote_feature_manage">管理緩存、數據源和各項設置</string>
    <string name="tv_onboarding_remote_feature_login">登錄 Bangumi 帳號，手機上打字更方便</string>
    <string name="tv_onboarding_next">下一步</string>
    <string name="tv_onboarding_step_login">登錄</string>
