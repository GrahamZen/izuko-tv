<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      应用的窗口主题, 只定窗口底色: 冷启动时系统先按它画启动窗口, 应用画出第一帧之前、界面留空的地方露出来的也是它.
      系统 DayNight 在电视上恒为浅色 (notnight 且锁死), 而应用默认主题是深色纯黑, 所以铺黑;
      启动后 MainActivity 换成用户主题的外壳底色 (见 WindowBackgroundMirror).
    -->
    <style name="Theme.Izuko" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!--
      换人重启途中接力显示同一帧的两页 (ProfileRestartActivity / ProfileSwitchLandingActivity): 透明, 系统就不给它们画启动窗口,
      下面那一页定格的画面一直露着, 直到本页把同一帧画上屏; 也不要进出场动画.
    -->
    <style name="Theme.Izuko.ProfileSwitch" parent="@android:style/Theme.Translucent.NoTitleBar.Fullscreen">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
