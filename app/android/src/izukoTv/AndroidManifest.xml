<!--
  ~ Android TV (tv flavor) 专属清单. AGP 会把本文件合并进 tv 变体, phone 变体完全不受影响.
  -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools">

    <!-- 主屏预览频道 (热门动画 / 继续观看) 写入系统 TvProvider -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <!-- Web 控制台「切到电视前台」(网页设置里的开关, 默认关): Android 10 起后台应用不能自己起界面, 这是唯一的通用豁免.
         只声明不会生效, 要用户在电视设置 → 应用 → 特殊应用权限 → 显示在其他应用的上层 里授权; 见 TvRemoteControl.frontGranted -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Web 控制台「退出 Ani 后保留」(网页设置里的开关, 默认关) 的常驻前台服务, 见 RemoteKeepAliveService -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 播放中卡住缓冲时日志里记 Wi-Fi 信号与协商速率 (普通权限, 安装时自动授予), 见 RebufferDiagnostics -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 片库 (设置「存储 → 片库」, 默认关) 放在各盘根目录下 Izuko/, 要「所有文件访问」: 只声明不会生效, 用户在系统设置里给
         (索尼这类没有专用授权页的: 应用信息 → 权限 → 文件和媒体 → 允许管理所有文件), 或用 adb appops; 见 AndroidMediaLibraryAccess -->
    <uses-permission
            android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
            tools:ignore="ScopedStorage" />
    <!-- 本地文件夹数据源在安卓 7.1~10 上读别的应用放的文件 (11 起用上面的「所有文件访问」): 在应用里弹框给;
         安卓 10 另要 application 上的 requestLegacyExternalStorage 才能按路径读. 见 AndroidLocalFolderAccess -->
    <uses-permission
            android:name="android.permission.READ_EXTERNAL_STORAGE"
            android:maxSdkVersion="29" />

    <!-- 不声明为必需: 同一个包也允许装在带触摸屏的设备上 -->
    <uses-feature
            android:name="android.software.leanback"
            android:required="false" />
    <uses-feature
            android:name="android.hardware.touchscreen"
            android:required="false" />

    <!-- requestLegacyExternalStorage: 只对安卓 10 起作用 (11 起系统不看), 见上面的 READ_EXTERNAL_STORAGE -->
    <application
            android:banner="@drawable/tv_banner"
            android:requestLegacyExternalStorage="true">

        <!-- 电视主屏启动器入口 -->
        <activity
                android:name=".activity.MainActivity"
                android:exported="true"
                tools:node="merge"
                android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 系统屏保: 轮播在看/热门动画的 TMDB 剧照, 确定键跳详情页.
             需用户在系统设置 → 屏保 里手动选择 Izuko TV -->
        <service
                android:name=".tv.AniDreamService"
                android:exported="true"
                android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- 本地文件夹数据源在安卓 7.1~10 上弹「存储」权限的授权框 (透明, 有结果就关) -->
        <activity
                android:name="me.him188.ani.app.domain.mediasource.clouddrive.LocalFolderPermissionActivity"
                android:exported="false"
                android:excludeFromRecents="true"
                android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Web 控制台「退出 Ani 后保留」: 抬高进程优先级, 被回收后重启时顺带把网页服务起起来 -->
        <service
                android:name=".tv.RemoteKeepAliveService"
                android:exported="false"
                android:foregroundServiceType="specialUse">
            <property
                    android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                    android:value="Keeps the LAN web remote control reachable after the TV app is closed (user opt-in)." />
        </service>

    </application>
</manifest>
